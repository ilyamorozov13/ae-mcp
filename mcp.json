{
  "mcpServers": {
    "adobe-after-effects": {
      "command": "node",
      "args": ["/ABSOLUTE/PATH/TO/ae-mcp/dist/stdio-server.js"],
      "env": {
        "AE_USE_FILE_BRIDGE": "true",
        "LOG_LEVEL": "info",
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    }
  }
}
